# ============================================
# WRAPPERS MASTER CONFIGURATION
# ============================================
# Master .env for all wrappers — copy wrapper-specific .env.example files
# for detailed per-wrapper configuration.
#
# This file contains SHARED settings used by all wrappers.

# ============================================
# REQUIRED: Client Authentication (Shared)
# ============================================
# All wrappers use the same BEARER_TOKEN for client authentication
# Clients (Claude Code, Codex, OpenAI SDK) send this token in Authorization header

BEARER_TOKEN=your-secure-random-token-here

# ============================================
# MODEL REGISTRY (Shared)
# ============================================
# Central intelligence service for model catalog
# All wrappers connect to this service

MODEL_REGISTRY_URL=http://127.0.0.1:9200
MODEL_REGISTRY_ADMIN_TOKEN=model-registry-local-key

# ============================================
# WRAPPER PORT MAP
# ============================================
# NVIDIA:        9101
# Nous:          9102
# OpenCode:      9103
# Blackbox:      9104
# Vercel:        9105
# Model Registry: 9200

# ============================================
# API KEYS
# ============================================
# Each wrapper has its own .env.example with provider-specific keys.
# Copy the relevant file to the wrapper directory:
#
# cp nvidia-python/.env.example nvidia-python/.env
# cp nous/.env.example nous/.env
# cp opencode/.env.example opencode/.env
# cp blackbox/.env.example blackbox/.env
# cp vercel/.env.example vercel/.env
# cp model-registry/.env.example model-registry/.env
#
# Then edit each .env and fill in the API keys.
