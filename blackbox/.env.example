# ============================================
# WRAPPER-BLACKBOX CONFIGURATION
# ============================================
# OpenAI + Anthropic compatible proxy for BLACKBOX AI
# Port: 9104

# ============================================
# REQUIRED: API Keys (Multi-key Rotation)
# ============================================
# Get keys from: https://blackbox.ai
# Format: sk-xxxxxxxxxxxx
# Add more keys with incrementing suffix for rotation

BLACKBOX_API_KEY_1=sk-xxx
BLACKBOX_API_KEY_2=sk-yyy
BLACKBOX_API_KEY_3=sk-zzz
BLACKBOX_API_KEY_4=sk-aaa

# ============================================
# REQUIRED: Client Authentication
# ============================================
# Clients (Claude Code, Codex, OpenAI SDK) must send this token
# Set to any secure random value

BEARER_TOKEN=your-secure-random-token-here

# ============================================
# OPTIONAL: OAuth Authentication
# ============================================
# Path to auth.json for OAuth token
# Format: {"providers": {"blackbox": {"access_token": "..."}}}

# AUTH_PATH=/root/.hermes/profiles/ilma/auth.json

# ============================================
# NETWORK CONFIGURATION
# ============================================

LISTEN_HOST=127.0.0.1
LISTEN_PORT=9104

# ============================================
# API ENDPOINT
# ============================================
# BLACKBOX AI API base URL

BLACKBOX_BASE_URL=https://api.blackbox.ai

# ============================================
# RATE LIMITING & KEY MANAGEMENT
# ============================================

# Per-key limits
BLACKBOX_HARD_LIMIT_RPM=60

# Global rate limit (per IP, per minute)
RATE_LIMIT_RPM=120

# Cooldown periods (seconds)
RATE_LIMIT_COOLDOWN_SEC=65
AUTH_KEY_COOLDOWN_SEC=300
TRANSIENT_KEY_COOLDOWN_SEC=15
KEY_COOLDOWN_MAX_SEC=300

# ============================================
# CONNECTION SETTINGS
# ============================================

MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_HOST=100
CONNECT_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=600
STREAM_REQUEST_TIMEOUT_SEC=900

# ============================================
# STREAMING & HEARTBEAT
# ============================================
# Anti-silence timeout for reasoning models (960s = 16min)

HEARTBEAT_INTERVAL_MS=5000
ANTI_SILENCE_TIMEOUT_MS=960000

# ============================================
# FREE MODEL RESTRICTION
# ============================================
# When FREE_ONLY=yes, only allow models with "free" in name

# FREE_ONLY=yes
# FREE_MODEL_ALLOWLIST=blackboxai/nvidia/nemotron-nano-12b-v2-vl

# ============================================
# DYNAMIC ALIAS CONFIGURATION
# ============================================
# Cold-start default for sonnet/haiku/opus aliases
# Must be a valid model from your provider

# DYNAMIC_ALIAS_TARGET=blackboxai/nvidia/nemotron-3-super-120b-a12b:free

# ============================================
# MODEL REGISTRY (Central Intelligence)
# ============================================

MODEL_REGISTRY_URL=http://127.0.0.1:9200
MODEL_REGISTRY_ADMIN_TOKEN=model-registry-local-key

# ============================================
# MODEL VERIFICATION
# ============================================
# Verify models on startup (uses API calls)

VERIFY_ON_BOOT=false

# ============================================
# LOGGING
# ============================================

LOG_FILE=/root/wrapper/blackbox/blackbox.log
