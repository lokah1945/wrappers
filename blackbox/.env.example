# wrapper-blackbox — OpenAI + Anthropic compatible proxy for BLACKBOX AI
# Public API base per BLACKBOX docs: https://api.blackbox.ai
BLACKBOX_API_KEY_1=sk-your-blackbox-key-here
BLACKBOX_API_KEY_2=
BLACKBOX_API_KEY_3=
BLACKBOX_API_KEY_4=
BLACKBOX_API_KEY_5=

# BB-10/F4: bind loopback by default. Setting 0.0.0.0 exposes the proxy to
# the network — only do that deliberately AND with BEARER_TOKEN set.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9104
# BB-3/SEC-2: REQUIRED for any non-loopback exposure. When empty the wrapper
# runs fully unauthenticated (a loud warning is logged at startup).
BEARER_TOKEN=change-me-local-service-token
BLACKBOX_BASE_URL=https://api.blackbox.ai

# Transparent default: client-selected models are allowed.
# Set FREE_ONLY=yes only as an explicit local policy restriction.
FREE_ONLY=no
# Free ids without substring "free" can be allowlisted here.
FREE_MODEL_ALLOWLIST=blackboxai/nvidia/nemotron-nano-12b-v2-vl
# Seed aliases (sonnet/haiku/opus/claude-*) to a known free model for Claude Code.
DYNAMIC_ALIAS_TARGET=blackboxai/nvidia/nemotron-3-super-120b-a12b:free

INFLIGHT_SOFT_CAP=100
SOFT_LIMIT_RPM=30
HARD_LIMIT_RPM=40
RATE_LIMIT_COOLDOWN_SEC=65
AUTH_KEY_COOLDOWN_SEC=300
TRANSIENT_KEY_COOLDOWN_SEC=15
KEY_COOLDOWN_MAX_SEC=300
HEARTBEAT_INTERVAL_MS=5000
REQUEST_TIMEOUT_SEC=600
STREAM_REQUEST_TIMEOUT_SEC=900
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_HOST=100
CONNECT_TIMEOUT_SEC=30

# Persistent model catalog and account-scoped availability state.
MODEL_STATE_DB=model-state.db
MODEL_CATALOG_TTL_SEC=21600
# Background catalog refresh; inference traffic is independent.
MODEL_CATALOG_REFRESH_SEC=86400
# Optional central model-intelligence service; empty keeps local-only mode.
MODEL_REGISTRY_URL=
MODEL_REGISTRY_ADMIN_TOKEN=

# ── Rate limiting ──
# BB-11: per-client-IP requests/minute on POST inference endpoints
# (/v1/chat/completions, /v1/responses, /v1/messages).
RATE_LIMIT_RPM=120

# ── Transparency gates (audit 2026-07-27) ──
# B11: fill `content: null → ""` and zero-usage defaults in non-stream chat
# responses (SDK compatibility). Set to `no` to forward upstream bodies verbatim.
COMPAT_FILL_DEFAULTS=yes
# B12: drop nameless tools from /v1/chat/completions requests before proxying
# (avoids upstream 4xx). Set to `no` to forward `tools` verbatim.
CLEAN_TOOLS=yes
# B7 (opt-in): pass upstream error bodies through verbatim instead of
# normalizing them to OpenAI/Anthropic error shape.
RAW_UPSTREAM_ERRORS=no
# B3 (opt-in): extra client request headers to forward upstream, comma-separated
# (credentials/hop-by-hop headers are always excluded). Empty = conservative
# allowlist (anthropic-beta, anthropic-version, openai-beta, x-request-id, user-agent).
FORWARD_EXTRA_HEADERS=
# F5: upstream Accept-Encoding. Empty lets aiohttp negotiate gzip/deflate
# (transparently decompressed). Set to `identity` to restore the old
# compression-disabling behaviour.
UPSTREAM_ACCEPT_ENCODING=
# BB-15: metrics snapshot persistence interval (seconds); snapshot is also
# written on graceful shutdown.
METRICS_PERSIST_SEC=60
