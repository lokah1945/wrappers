# Optional protection for internal catalog/observation write endpoints.
MODEL_REGISTRY_ADMIN_TOKEN=
MODEL_REGISTRY_HOST=127.0.0.1
MODEL_REGISTRY_PORT=9200
# NEW-3 fix: use an ABSOLUTE path. A relative value resolves against the
# process working directory and silently re-creates DB-path drift.
MODEL_REGISTRY_DB=/root/wrapper/model-registry/registry-state.db
