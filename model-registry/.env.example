# ============================================
# MODEL-REGISTRY CONFIGURATION
# ============================================
# Central intelligence service for model catalog and observations
# Port: 9200

# ============================================
# REQUIRED: Admin Authentication
# ============================================
# Required for internal write endpoints (catalog updates, observations)
# Wrappers authenticate with this token to push model data

MODEL_REGISTRY_ADMIN_TOKEN=model-registry-local-key

# ============================================
# NETWORK CONFIGURATION
# ============================================

MODEL_REGISTRY_HOST=127.0.0.1
MODEL_REGISTRY_PORT=9200

# ============================================
# DATABASE
# ============================================
# SQLite database for model profiles and observations
# Use ABSOLUTE path — relative paths resolve against process CWD

MODEL_REGISTRY_DB=/root/wrapper/model-registry/registry-state.db

# ============================================
# LOGGING
# ============================================

LOG_FILE=/root/wrapper/model-registry/model-registry.log
