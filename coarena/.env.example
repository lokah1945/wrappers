# wrapper-coarena environment template — copy to .env and fill in.
# NEVER commit real credentials; the historical committed key must be rotated.

# ── Upstream credential pool (contract §9.2: <PREFIX>_API_KEY_1..N) ──────
# One Coarena personal key per variable; rotation across all of them.
# Mint keys at https://coarena.ai/account/api (format coa_ + 32 hex).
COARENA_API_KEY_1=coa_replace_me_with_a_real_personal_key
# COARENA_API_KEY_2=coa_second_key_for_rotation
# COARENA_API_KEY_3=coa_third_key_for_rotation

# ── Client authentication (fail closed when unset — contract §5) ─────────
BEARER_TOKEN=replace-with-a-secure-local-token
# REQUIRE_AUTH=true            # default; set false only for deliberate open LAN mode
# DISABLE_AUTH=                # explicit open mode override (unsafe)

# ── Upstream base URL ────────────────────────────────────────────────────
# OpenAI-style and Anthropic-style Model API share the /api/v1 path prefix.
COARENA_BASE_URL=https://coarena.ai/api/v1

# ── Per-key pacing (upstream documented limit: 30 req/min per key) ───────
COARENA_SOFT_LIMIT_RPM=25
COARENA_HARD_LIMIT_RPM=30

# ── Per-IP rate limit (0 disables — multi-agent setups) ─────────────────
RATE_LIMIT_RPM=600

# ── Upstream dialect (operator-declared, contract §9.2) ──────────────────
# 1 = OpenAI compatible (default; Coarena serves chat/completions + responses)
# 2 = Anthropic compatible (Coarena serves messages natively)
# 3 = Auto discovery
COMPATIBILITY_LAYER=1
# RESPONSES_UPSTREAM_MODE=auto   # auto | native | chat
# NATIVE_MESSAGES_MODE=native    # native | translate

# ── Timeouts / streaming / lifecycle ─────────────────────────────────────
HEARTBEAT_INTERVAL_MS=5000
STREAM_SOCK_READ_TIMEOUT_SEC=300
CONNECT_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=600
MAX_REQUEST_BYTES=10485760
SHUTDOWN_DRAIN_SEC=30
METRICS_PERSIST_SEC=60

# ── Response store (previous_response_id continuity, three-axis bound) ───
RESPONSES_STORE_MAX_ENTRIES=200
RESPONSES_STORE_MAX_BYTES=33554432
RESPONSES_STORE_TTL_SEC=3600

# ── Optional policy switches ─────────────────────────────────────────────
# FREE_ONLY=no                  # all Coarena models are on the free funded tier
# FREE_MODEL_ALLOWLIST=         # comma-separated ids; empty means every model
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=9107
