[Unit]
Description=Coarena API Wrapper (OpenAI/Anthropic compatible)
After=network.target
Requires=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/wrapper/coarena
EnvironmentFile=-/root/wrapper/coarena/.env
Environment=PYTHONPATH=/root/wrapper/coarena:/root/wrapper
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 9107
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/wrapper/coarena
ProtectHome=read-only

[Install]
WantedBy=multi-user.target