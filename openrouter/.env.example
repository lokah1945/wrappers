# ============================================
# WRAPPER-OPENROUTER CONFIGURATION
# ============================================
# OpenAI + Anthropic compatible proxy for OpenRouter
# Port: 9106
#
# OpenRouter: https://openrouter.ai
# API Docs: https://openrouter.ai/docs
# Get API keys: https://openrouter.ai/keys

# ============================================
# REQUIRED: API Keys (Multi-key Rotation)
# ============================================
# Add more keys with incrementing suffix for rotation
# Format: sk-or-v1-xxxxxxxxxxxx

OPENROUTER_API_KEY_1=sk-or-v1-xxx
OPENROUTER_API_KEY_2=sk-or-v1-yyy
OPENROUTER_API_KEY_3=sk-or-v1-zzz

# ============================================
# REQUIRED: Client Authentication
# ============================================
# Clients (Claude Code, Codex, OpenAI SDK) must send this token
# Set to any secure random value

BEARER_TOKEN=your-secure-random-token-here

# ============================================
# AUTHENTICATION MODE
# ============================================
# Set DISABLE_AUTH=1 to skip bearer token validation (pre-auth/open mode)
# WARNING: Only use in trusted networks

# DISABLE_AUTH=1

# ============================================
# OPENROUTER MANAGEMENT KEY (Provisioning API)
# ============================================
# Management API keys allow programmatic CRUD of OpenRouter API keys.
# They CANNOT be used for inference — exclusively for admin operations.
# Set the actual key in .env.local (gitignored), NOT in .env (tracked).
# Docs: https://openrouter.ai/docs/guides/overview/auth/management-api-keys
#
# Endpoints exposed when configured:
#   POST /openrouter/keys/list    — List 100 most recent keys
#   POST /openrouter/keys/create  — Create a new API key
#   GET  /openrouter/keys/{hash}  — Get key details
#   PATCH /openrouter/keys/{hash} — Update key (name, disable, limit_reset)
#   DELETE /openrouter/keys/{hash}— Permanently delete a key
#   POST /openrouter/keys/rotate  — Zero-downtime key rotation

OPENROUTER_MANAGEMENT_ENABLED=yes
# OPENROUTER_MANAGEMENT_KEY=sk-or-mgmt-...     # <-- Set in .env.local!

# ============================================
# NETWORK CONFIGURATION
# ============================================

LISTEN_HOST=127.0.0.1
LISTEN_PORT=9106

# ============================================
# API ENDPOINTS
# ============================================

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================
# FREE_ONLY MODE
# ============================================
# When enabled, only free models (:free suffix or $0 pricing) are accessible
# FREE_ONLY=yes

FREE_ONLY=no

# ============================================
# CATALOG DATABASE (Shared with MCP Server)
# ============================================
# Path to the shared SQLite catalog database from nvidia-nim_model_fetcher
# Leave empty to use default path

# CATALOG_DB=/root/nvidia-nim_model_fetcher/data/active_nvidia_nim.sqlite3

# ============================================
# RATE LIMITING & KEY MANAGEMENT
# ============================================

# Per-key limits
HARD_LIMIT_RPM=60
SOFT_LIMIT_RPM=30

# Global rate limit (per IP, per minute)
RATE_LIMIT_RPM=120

# Cooldown periods (seconds)
RATE_LIMIT_COOLDOWN_SEC=65
AUTH_KEY_COOLDOWN_SEC=300
TRANSIENT_KEY_COOLDOWN_SEC=15
KEY_COOLDOWN_MAX_SEC=300

# ============================================
# CONNECTION SETTINGS
# ============================================

MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_HOST=100
CONNECT_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=600
STREAM_REQUEST_TIMEOUT_SEC=900

# ============================================
# STREAMING & HEARTBEAT
# ============================================
# Anti-silence timeout for reasoning models (960s = 16min)

HEARTBEAT_INTERVAL_MS=5000
ANTI_SILENCE_TIMEOUT_MS=960000

# ============================================
# MODEL REGISTRY (Central Intelligence)
# ============================================

MODEL_REGISTRY_URL=http://127.0.0.1:9200
MODEL_REGISTRY_ADMIN_TOKEN=model-registry-local-key

# ============================================
# MODEL VERIFICATION
# ============================================

VERIFY_ON_BOOT=false

# ============================================
# TRANSPARENCY GATES
# ============================================
# These gates control SDK-compatibility mutations (opt-in by default)

# COMPAT_FILL_DEFAULTS=yes    # Fill content: null -> ""
# CLEAN_TOOLS=yes              # Drop nameless tools (upstream-4xx avoidance)
# RAW_UPSTREAM_ERRORS=no       # Pass through verbatim error bodies

# ============================================
# LOGGING
# ============================================

LOG_FILE=/root/wrapper/openrouter/openrouter.log

# ============================================
# UPSTREAM COMPATIBILITY LAYER
# ============================================
# Which API protocol does the UPSTREAM speak?
#   1 = OpenAI Compatible  (chat completions: POST /chat/completions)
#   2 = Anthropic Compatible (messages: POST /v1/messages)
#   3 = Auto Discovery     (probe upstream at startup / first use)
# Default: 1 (OpenAI Compatible) — preserves current behaviour exactly.
# The operator declares this consciously so the wrapper never guesses the
# upstream dialect; translation is precise per surface.
COMPATIBILITY_LAYER=1
