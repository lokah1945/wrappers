# ============================================
# WRAPPER-NOUS CONFIGURATION
# ============================================
# OpenAI + Anthropic compatible proxy for Nous Research
# Port: 9102

# ============================================
# REQUIRED: API Keys (Multi-key Rotation)
# ============================================
# Get keys from: https://nousresearch.com/api
# Format: nous_xxxxxxxxxxxx
# Add more keys with incrementing suffix for rotation

NOUS_API_KEY_1=nous_xxx
NOUS_API_KEY_2=nous_yyy
NOUS_API_KEY_3=nous_zzz
NOUS_API_KEY_4=nous_aaa

# ============================================
# REQUIRED: Client Authentication
# ============================================
# Clients (Claude Code, Codex, OpenAI SDK) must send this token
# Set to any secure random value

BEARER_TOKEN=your-secure-random-token-here

# ============================================
# OPTIONAL: OAuth Authentication
# ============================================
# Path to auth.json for OAuth token
# Format: {"providers": {"nous": {"access_token": "..."}}}

# AUTH_PATH=/root/.hermes/profiles/ilma/auth.json

# ============================================
# NETWORK CONFIGURATION
# ============================================

LISTEN_HOST=127.0.0.1
LISTEN_PORT=9102

# ============================================
# API ENDPOINT
# ============================================
# Nous Research API base URL

NOUS_BASE_URL=https://inference-api.nousresearch.com

# ============================================
# RATE LIMITING & KEY MANAGEMENT
# ============================================

# Per-key limits
NOUS_HARD_LIMIT_RPM=60

# Global rate limit (per IP, per minute)
RATE_LIMIT_RPM=120

# Cooldown periods (seconds)
RATE_LIMIT_COOLDOWN_SEC=65
AUTH_KEY_COOLDOWN_SEC=300
TRANSIENT_KEY_COOLDOWN_SEC=15
KEY_COOLDOWN_MAX_SEC=300

# ============================================
# CONNECTION SETTINGS
# ============================================

MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_HOST=100
CONNECT_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=600
STREAM_REQUEST_TIMEOUT_SEC=900

# ============================================
# STREAMING & HEARTBEAT
# ============================================
# Anti-silence timeout for reasoning models (960s = 16min)

HEARTBEAT_INTERVAL_MS=5000
ANTI_SILENCE_TIMEOUT_MS=960000

# ============================================
# FREE MODEL RESTRICTION
# ============================================
# When FREE_ONLY=yes, only allow models with "free" in name

# FREE_ONLY=yes
# FREE_MODEL_ALLOWLIST=

# ============================================
# DYNAMIC ALIAS CONFIGURATION
# ============================================
# Cold-start default for sonnet/haiku/opus aliases
# Must be a valid model from your provider

# DYNAMIC_ALIAS_TARGET=tencent/hy3:free

# ============================================
# MODEL REGISTRY (Central Intelligence)
# ============================================

MODEL_REGISTRY_URL=http://127.0.0.1:9200
MODEL_REGISTRY_ADMIN_TOKEN=model-registry-local-key

# ============================================
# MODEL VERIFICATION
# ============================================
# Verify models on startup (uses API calls)

VERIFY_ON_BOOT=false

# ============================================
# LOGGING
# ============================================

LOG_FILE=/root/wrapper/nous/nous.log

# ============================================
# UPSTREAM COMPATIBILITY LAYER
# ============================================
# Which API protocol does the UPSTREAM speak?
#   1 = OpenAI Compatible  (chat completions: POST /chat/completions)
#   2 = Anthropic Compatible (messages: POST /v1/messages)
#   3 = Auto Discovery     (probe upstream at startup / first use)
# Default: 1 preserves matching OpenAI Chat; Responses policy is configured below.
# The operator declares this consciously so the wrapper never guesses the
# upstream dialect; translation is precise per surface.
COMPATIBILITY_LAYER=1

# Native Responses first. The Chat adapter is permitted only for a confirmed
# unsupported native route (405, 501 or definite route 404), using the same model.
# Authentication, quota, model errors and malformed native streams do not fall back.
RESPONSES_UPSTREAM_MODE=auto

# Nous requires honest operational tags when the client omits tags.
# Explicit client tags are preserved, including an empty list.
# Optional comma-separated override; default identifies this wrapper honestly.
# NOUS_REQUEST_TAGS=product=wrapper-nous,client=wrapper-nous,user=wrapper-nous

# Context metadata: persisted provider catalog, served without inference-time fetches.
# Background cadence is min(REFRESH, TTL), with a minimum of 60 seconds.
MODEL_CATALOG_TTL_SEC=21600
MODEL_CATALOG_REFRESH_SEC=86400
# SQLite also holds credential/endpoint-scoped numeric context-error observations.
# MODEL_STATE_DB=/path/to/model-state.db
