[Unit]
Description=wrapper-nous: Anthropic+Responses+Chat proxy for Nous (port 9102)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/wrapper/nous
Environment=PYTHONPATH=/root/wrapper/nous
EnvironmentFile=-/root/wrapper/nous/.env
Environment=LOG_FILE=/root/wrapper/nous/wrapper_nous.log
ExecStartPre=/bin/bash -c 'mkdir -p /root/wrapper/runtime && git -C /root/wrapper rev-parse HEAD > /root/wrapper/runtime/nous.commit 2>/dev/null || true'
ExecStart=/usr/bin/python3 wrapper_nous.py
Restart=always
RestartSec=3
StandardOutput=append:/root/wrapper/nous/wrapper_nous.log
StandardError=append:/root/wrapper/nous/wrapper_nous.log

[Install]
WantedBy=default.target
