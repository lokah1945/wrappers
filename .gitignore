# Secrets — NEVER commit
.env
.env.bkp
.env.local
.env.*.local
!.env.example

# Logs
*.log
metrics_data/
server.log

# Runtime data
*.tmp
metrics.db
metrics.db-*
metrics.db.*

# Backups (managed by backup.sh)
backups/*

# Local audit reports (ILMA) — not part of source
audit_report/

# Cache
node_modules/
.npm/
*.tgz

# Editor
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Audit artifacts
*.bak
.audit-*/

# Restore script temp
restore/

# Python caches (global)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/
venv/
env/
dist/
build/

# Database files (runtime artifacts)
*.db*
metrics.db*

# Local backup directories — never push to GitHub
nvidia_backup_*/
nvidia.backup.*/
*_backup_*/

# Artifacts and archives
artifacts/
*.tar.gz

# Test coverage
.coverage
htmlcov/

# F10: per-wrapper metrics snapshots are runtime artifacts
metrics-snapshot.json

# nvidia-python NGC featured-models cache (runtime artifact, fetched from NGC)
ngc-featured-cache.json

# F5: deploy markers are runtime state; a tracked marker can never hold its
# own deploy commit (git pull clobbers it). Trust /health git_commit instead.
runtime/
.deployed_commit
