# ============================================
# WRAPPER-NVIDIA CONFIGURATION
# ============================================
# OpenAI + Anthropic compatible proxy for NVIDIA NIM API
# Port: 9101
# NOTE: NVIDIA NIM is inherently free-tier only — no FREE_ONLY config needed

# ============================================
# REQUIRED: API Keys (Multi-key Rotation)
# ============================================
# Get keys from: https://build.nvidia.com/explore/discover
# Format: nvapi-xxxxxxxxxxxx
# Add more keys with incrementing suffix for rotation
# Free tier provides generous limits — add multiple keys for rotation

NVIDIA_API_KEY_1=nvapi-xxx
NVIDIA_API_KEY_2=nvapi-yyy
NVIDIA_API_KEY_3=nvapi-zzz
NVIDIA_API_KEY_4=nvapi-aaa

# ============================================
# REQUIRED: Client Authentication
# ============================================
# Clients (Claude Code, Codex, OpenAI SDK) must send this token
# Set to any secure random value

BEARER_TOKEN=your-secure-random-token-here

# ============================================
# OPTIONAL: OAuth Authentication
# ============================================
# Path to auth.json for OAuth token
# Format: {"providers": {"nvidia": {"access_token": "..."}}}

# AUTH_PATH=/root/.hermes/profiles/ilma/auth.json

# ============================================
# NETWORK CONFIGURATION
# ============================================

LISTEN_HOST=127.0.0.1
LISTEN_PORT=9101

# ============================================
# API ENDPOINTS
# ============================================
# NVIDIA NIM provides multiple base URLs for different services

NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_GENAI_URL=https://ai.api.nvidia.com
NVIDIA_NVCF_URL=https://api.nvcf.nvidia.com

# ============================================
# RATE LIMITING & KEY MANAGEMENT
# ============================================

# Per-key limits
NVIDIA_HARD_LIMIT_RPM=60

# Global rate limit (per IP, per minute)
RATE_LIMIT_RPM=120

# Cooldown periods (seconds)
RATE_LIMIT_COOLDOWN_SEC=65
AUTH_KEY_COOLDOWN_SEC=300
TRANSIENT_KEY_COOLDOWN_SEC=15
KEY_COOLDOWN_MAX_SEC=300

# ============================================
# CONNECTION SETTINGS
# ============================================

MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_HOST=100
CONNECT_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=600
STREAM_REQUEST_TIMEOUT_SEC=900

# ============================================
# STREAMING & HEARTBEAT
# ============================================
# Anti-silence timeout for reasoning models (960s = 16min)

HEARTBEAT_INTERVAL_MS=5000
ANTI_SILENCE_TIMEOUT_MS=960000

# ============================================
# DYNAMIC ALIAS CONFIGURATION
# ============================================
# Cold-start default for sonnet/haiku/opus aliases
# Must be a valid NVIDIA NIM model

# DYNAMIC_ALIAS_TARGET=nvidia/llama-3.3-nemotron-super-49b-v1

# ============================================
# MODEL REGISTRY (Central Intelligence)
# ============================================

MODEL_REGISTRY_URL=http://127.0.0.1:9200
MODEL_REGISTRY_ADMIN_TOKEN=model-registry-local-key

# ============================================
# MODEL VERIFICATION
# ============================================
# Verify models on startup (uses API calls)

VERIFY_ON_BOOT=false
# Periodic inference probes begin after VERIFY_INTERVAL seconds, independently
# of public catalog refresh. Disable in staging and when no probes are wanted.
VERIFY_PERIODIC_ENABLED=true
VERIFY_INTERVAL=1800
# Reuse exact-contract observations across process restarts for discovery, but
# never advertise availability older than this window. 0 disables the age cap.
MODEL_DISCOVERY_STATUS_TTL_SEC=86400

# ============================================
# LOGGING
# ============================================

LOG_FILE=/root/wrapper/nvidia-python/nvidia-python.log

# ============================================
# UPSTREAM COMPATIBILITY LAYER
# ============================================
# Which API protocol does the UPSTREAM speak?
#   1 = OpenAI Compatible  (chat completions: POST /chat/completions)
#   2 = Anthropic Compatible (messages: POST /v1/messages)
#   3 = Auto Discovery     (probe upstream at startup / first use)
# Default: 1 preserves matching OpenAI Chat; Responses policy is configured below.
# The operator declares this consciously so the wrapper never guesses the
# upstream dialect; translation is precise per surface.
COMPATIBILITY_LAYER=1

# Native Responses first. The Chat adapter is permitted only for a confirmed
# unsupported native route (405, 501 or definite route 404), using the same model.
# Authentication, quota, model errors and malformed native streams do not fall back.
RESPONSES_UPSTREAM_MODE=auto

# Exact-model context metadata; no family/default context guesses.
# /v1/models limits take precedence over NVIDIA's published catalog/specifications.
REGISTRY_REFRESH_SEC=3600
# NGC_CONTEXT_CACHE_FILE=/path/to/ngc-featured-cache.json
NVIDIA_BUILD_CONTEXT_ENABLED=true
NVIDIA_BUILD_CONTEXT_REFRESH_SEC=86400
NVIDIA_BUILD_CONTEXT_CONCURRENCY=3
# Build specifications are fetched in background, never on inference requests.
# Missing/rounded/ambiguous metadata stays unknown. Failed fetches keep stale data.
# WRAPPER_AUTO_TRUNCATE is retired: history and tool results are always preserved.

# ============================================
# NVIDIA NIM / NGC METADATA SYNC
# ============================================
# Public, read-only NGC repository/tag/profile metadata. This enriches the
# complete Build catalog but never replaces hosted/deployment availability.
NVIDIA_NIM_METADATA_ENABLED=true
NVIDIA_NIM_METADATA_REFRESH_SEC=21600
NVIDIA_NIM_METADATA_TTL_SEC=21600
NVIDIA_NIM_METADATA_CONCURRENCY=8
# NVIDIA_NIM_METADATA_CACHE_FILE=/root/wrapper/nvidia-python/nim-metadata-cache.json
# Optional exact Build-ID -> NGC resource/tag overrides, JSON object.
# NVIDIA_NIM_RESOURCE_OVERRIDES={"nvidia/example":{"resource_id":"nim/nvidia/example","tag":"1.0"}}
# Optional target hardware used only to label profile fit/does_not_fit/unknown.
# NVIDIA_NIM_TARGET_GPU_DEVICE=2330:10de
# NVIDIA_NIM_TARGET_GPU_COUNT=1
# NVIDIA_NIM_TARGET_VRAM_GB=80
# NVIDIA_NIM_TARGET_DRIVER_VERSION=550.54.14
