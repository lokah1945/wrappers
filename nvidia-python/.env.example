# NVIDIA NIM API Keys (add as many as needed)
NVIDIA_API_KEY_1=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY_2=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY_3=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate limit settings
SOFT_LIMIT_RPM=30
HARD_LIMIT_RPM=40

# Server settings
# V-06: code default is now 127.0.0.1 (loopback). Set 0.0.0.0 ONLY if you
# intentionally expose the proxy (the /dashboard page embeds the bearer token).
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9101
METRICS_DB=metrics.db
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
QUEUE_LIMIT=4
KEYS_RELOAD_SECONDS=60

# Throughput Stability Settings
MAX_CONNECTIONS=1000
MAX_QUEUE_SIZE=500
INFLIGHT_SOFT_CAP=100
LOAD_SHEDDING_ENABLED=true
HEADERS_TIMEOUT_MS=180000
PRE_RESPONSE_TIMEOUT_MS=300000
PACING_MAX_WAIT=120
REQUEST_TIMEOUT=300
STREAM_REQUEST_TIMEOUT_SEC=900
VERIFY_CONCURRENCY=16
VERIFY_ON_BOOT=false

# Auth (optional). Empty = open local proxy.
BEARER_TOKEN=wrapper-local-key

# Logging
WRAPPER_JSON_LOG=true
STREAM_HEARTBEAT=true

# Parameter Injection
WRAPPER_PARAMS=temperature,top_p
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=1.0
DROP_PARAMS=think
TTFT_TIMEOUT_MS=120000

# Server / stream timeouts (reasoning-model friendly)
ANTI_SILENCE_TIMEOUT_MS=960000
SERVER_KEEPALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=35000
GEN_TIMEOUT_SEC=900

# Dynamic aliases (NO hardcoded model targets):
# When a client calls a concrete model (e.g. minimaxai/minimax-m3 or z-ai/glm-5.2),
# all Claude Code short names (sonnet/haiku/opus/claude-*) bind to that model.
# Optional seed at boot (still not a hardcode in code — operator choice only):
# DYNAMIC_ALIAS_TARGET=minimaxai/minimax-m3


# NOTE: FREE_ONLY is NOT used by wrapper-nvidia (NVIDIA NIM catalog is already free-tier accessible).
# FREE_ONLY applies only to wrapper-nous and wrapper-opencode.

# Model-specific guardrails (Claude Code / Anthropic-compatible clients may request
# larger max_tokens or thinking controls than a given NIM model accepts).
# Defaults in code include moonshotai/kimi-k2.6:16384 and skip reasoning injection for Kimi K2.6.
# Override/add caps with comma-separated pattern:cap pairs.
# MODEL_MAX_TOKENS_CAPS=moonshotai/kimi-k2.6:16384
# DISABLE_REASONING_INJECTION_PATTERNS=moonshotai/kimi-k2.6,kimi-k2.6
# STRICT_BLOCK_UNAVAILABLE_MODELS=false

# Persistent model catalog and account-scoped availability state.
MODEL_STATE_DB=model-state.db
MODEL_CATALOG_TTL_SEC=21600
# Catalog refresh and verification are independent. Verification never turns
# account-scoped 404s into global retirement.
MODEL_REFRESH_SEC=600
# F7: default sweep interval raised to 1800s; sweeps are also skipped while
# live requests are queued on the key pool.
VERIFY_INTERVAL=1800
VERIFY_ON_BOOT=false
# Persistent catalog refresh is independent of account availability probes.
MODEL_CATALOG_REFRESH_SEC=600
# Optional central model-intelligence service; empty keeps local-only mode.
MODEL_REGISTRY_URL=
MODEL_REGISTRY_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Transparency / behavior flags (audit fixes 2026-07-27).
# Transparent by default: the wrapper mutates requests/responses only when
# compat/emulation strictly requires it, or when explicitly opted in here.
# ---------------------------------------------------------------------------
# V1/F6: auto-inject default reasoning params (chat_template_kwargs etc.) for
# requires_reasoning models when the client did NOT ask. Default 0 = never
# inject without explicit client intent.
WRAPPER_AUTO_REASONING=0
# V15: replace an empty message.content on plain /v1/chat/completions with the
# model's private reasoning text. Default 0 = only the SDK-safety null->"" fix.
WRAPPER_SURFACE_REASONING=0
# V4: drop the built-in list of params NVIDIA verifiably rejects (think +
# context_* family). Set 0 to disable built-in drops entirely. Keys listed in
# DROP_PARAMS are always dropped (operator opt-in). max_output_tokens is never
# silently deleted: it maps to max_tokens when max_tokens is absent, otherwise
# it is dropped with a debug log.
WRAPPER_DROP_BUILTIN_PARAMS=1
# V7: inject stream_options.include_usage on plain /v1/chat/completions streams
# too. Default 0 = injected only on translated /v1/messages + /v1/responses
# paths where the wrapper itself needs usage.
WRAPPER_FORCE_USAGE=0
# V19: silently truncate /v1/messages histories that exceed the estimated
# context window. Default 0 = forward as-is and let upstream decide.
WRAPPER_AUTO_TRUNCATE=0
# V25: emit a synthetic "[Reasoning not supported...]" thinking block when the
# client requested thinking but the model produced none. Default 0 = omit.
WRAPPER_SYNTHETIC_THINKING=0

# V-09: read-idle timeout (seconds) for streamed upstream responses. Streams no
# longer use a hard total timeout that killed long generations mid-stream.
STREAM_SOCK_READ_TIMEOUT_SEC=300
# V-04: Loki push hardening — max buffered records (drop-oldest) and the number
# of consecutive 401/403 responses after which pushes are disabled (log once).
LOKI_MAX_BUFFER=1000
LOKI_AUTH_FAILURE_LIMIT=3
# V-11: rotate wrapper-events.jsonl when it exceeds this many MB.
WRAPPER_EVENTS_MAX_MB=64
# V-22: byte cap for the /v1/responses previous_response_id history store.
RESPONSES_STORE_MAX_BYTES=67108864
